# SalarySeed Local Environment Configuration
# Copy this file to .env and replace the placeholder values with your actual project keys.
# NEVER commit .env to version control or expose service-role secret keys!

# Supabase Project URL (From Supabase Dashboard -> Project Settings -> API)
VITE_SUPABASE_URL=https://your-project-id.supabase.co

# Supabase Public Anon / Publishable Key (Safe for browser use)
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key-placeholder

# Optional Production Domain (once purchased / deployed)
VITE_SITE_URL=http://localhost:3000
